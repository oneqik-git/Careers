# ── SERVER ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── DATABASE (Hostinger MySQL) ───────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oqc_db
DB_USER=root
DB_PASSWORD=root123
DB_POOL_MAX=10

# ── JWT ──────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# ── DIGILOCKER (sandbox for dev) ─────────
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_secret
DIGILOCKER_REDIRECT_URI=https://yourdomain.com/api/auth/digilocker/callback
DIGILOCKER_API_URL=https://api.digitallocker.gov.in

# ── FILE UPLOADS ─────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_PATH=./uploads

# ── CORS ─────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# ── RATE LIMITING ────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── CAREER SCORE WEIGHTS (adjustable) ────
SCORE_BASE=300
SCORE_MAX=900
WEIGHT_SKILL_IMPACT=0.30
WEIGHT_CREDIBILITY=0.25
WEIGHT_ENGAGEMENT=0.20
WEIGHT_VALUES=0.15
WEIGHT_IDENTITY=0.10
